#include <iostream>
#include <vector>
using namespace std;

struct Trie {

    struct Node {

        int nxt[26];
        int pref;     // cuántas palabras pasan
        int end;      // cuántas terminan

        Node() {

            for(int i=0;i<26;i++)
                nxt[i]=-1;

            pref=0;
            end=0;
        }
    };

    vector<Node> trie;

    Trie() {
        trie.push_back(Node()); // raíz
    }

    void insert(string s){

        int cur=0;

        for(char c:s){

            int x=c-'a';

            if(trie[cur].nxt[x]==-1){

                trie[cur].nxt[x]=trie.size();
                trie.push_back(Node());
            }

            cur=trie[cur].nxt[x];

            trie[cur].pref++;
        }

        trie[cur].end++;
    }


    bool search(string s){

        int cur=0;

        for(char c:s){

            int x=c-'a';

            if(trie[cur].nxt[x]==-1)
                return false;

            cur=trie[cur].nxt[x];
        }

        return trie[cur].end>0;
    }


    int countPrefix(string s){

        int cur=0;

        for(char c:s){

            int x=c-'a';

            if(trie[cur].nxt[x]==-1)
                return 0;

            cur=trie[cur].nxt[x];
        }

        return trie[cur].pref;
    }

};


int main(){

    Trie t;

    t.insert("cat");
    t.insert("car");
    t.insert("care");

    cout<<t.search("cat")<<endl;
    cout<<t.countPrefix("ca")<<endl;

    return 0;
}
