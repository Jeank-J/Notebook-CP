//====================================
// agregar subárbol completo
//====================================

void add_subtree(int u,int p){

    add(u);

    for(auto v:g[u]){

        if(v==p || big[v])
            continue;

        add_subtree(v,u);
    }
}

void remove_subtree(int u,int p){

    remove(u);

    for(auto v:g[u]){

        if(v==p || big[v])
            continue;

        remove_subtree(v,u);
    }
}


//====================================
// DSU on Tree
//====================================

void dfs(int u,int p,bool keep){

    // pequeños
    for(auto v:g[u]){

        if(v==p || v==heavy[u])
            continue;

        dfs(v,u,false);
    }


    // pesado
    if(heavy[u]!=-1){

        dfs(heavy[u],u,true);

        big[heavy[u]]=true;
    }


    // volver a agregar pequeños
    for(auto v:g[u]){

        if(v==p || v==heavy[u])
            continue;

        add_subtree(v,u);
    }


    // agregar nodo actual
    add(u);


    //================================
    // responder consultas de u
    //================================

    // for(auto [query,id]:queries[u]){
    //
    //      ans[id]=answer(query);
    // }


    if(heavy[u]!=-1)
        big[heavy[u]]=false;


    // borrar si no conservar
    if(!keep){

        remove_subtree(u,p);
    }
}
