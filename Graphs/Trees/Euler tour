int tree[N * 2];
int tin[N];
int tout[N];

int timer = 0;

void dfs(int u, int p, vector <vector<int>> &g){
    tin[u] = timer++;
    for (auto child: g[u]){
        if (child != p){
            dfs(child,u,g);
        }
    }
    tout[u]  = timer++;
}

// build arbol aplanado
for (int i = 0; i < n; i++){
  tree[tin[i]] = i;
  tree[tout[i]] = i;
}

