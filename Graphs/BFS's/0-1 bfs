/*
0-1 BFS

Encuentra caminos mínimos cuando las aristas tienen
pesos únicamente 0 o 1.

Complejidad:
O(V+E)
*/

vector<int> bfs01(int n, vector<vector<pair<int,int>>>& adj, int source){

    const int INF=1e9;

    vector<int> dist(n+1,INF);

    deque<int> dq;

    dist[source]=0;
    dq.push_front(source);

    while(!dq.empty()){

        int u=dq.front();
        dq.pop_front();

        for(auto [v,w]:adj[u]){

            if(dist[u]+w<dist[v]){

                dist[v]=dist[u]+w;

                if(w==0)
                    dq.push_front(v);
                else
                    dq.push_back(v);
            }
        }
    }

    return dist;
}
