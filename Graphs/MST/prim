/*
Prim

Construye un MST expandiendo desde un nodo y tomando
siempre la arista mínima hacia un nodo no visitado.

Complejidad:
O(m log n)
*/

long long prim(int n,vector<vector<pair<int,int>>>& adj){

    priority_queue< pair<int,int>, vector<pair<int,int>>, greater<pair<int,int>> > pq;

    vector<bool> vis(n+1,false);
    pq.push({0,1});
    long long cost=0;

    while(!pq.empty()){

        auto [w,u]=pq.top();
        pq.pop();
        if(vis[u]) continue;

        vis[u]=true;
        cost+=w;

        for(auto [v,nw]:adj[u]){
            if(!vis[v]) pq.push({nw,v});
        }
    }

    return cost;
}
