struct STsum {

    vector <ll> st;

    STsum(int n){
        st.resize(n * 4);
    }


    ll oper(ll L, ll R) {
        return L + R;
    }

    void build(int nodo, int l, int r, const vector<ll> &v) {
        if (l == r) {
            st[nodo] = v[l];
            return;
        }
        int mid = (l + r) / 2;
        build(nodo * 2, l, mid, v);
        build(nodo * 2 + 1, mid + 1, r, v);
        st[nodo] = oper(st[nodo * 2], st[nodo * 2 + 1]);
    }

    ll query(int nodo, int l, int r, int lt, int rt) {
        if (l > rt or r < lt) return 0;
        if (l >= lt and r <= rt) return st[nodo];
        
        int mid = (l+r) / 2;
        ll L = query(nodo * 2, l, mid, lt, rt);
        ll R = query(nodo * 2 + 1, mid+1, r, lt, rt);

        return L + R;
    }

};

struct STmx {

    vector <ll> st;
    STmx (int n){
        st.resize(n * 4);
    }    

    ll oper(ll L, ll R) {
        return max(L, R);
    }

    void build(int nodo, int l, int r, const vector<ll> &v) {
        if (l == r) {
            st[nodo] = v[l];
            return;
        }
        int mid = (l + r) / 2;
        build(nodo * 2, l, mid, v);
        build(nodo * 2 + 1, mid + 1, r, v);
        st[nodo] = oper(st[nodo * 2], st[nodo * 2 + 1]);
    }    

    ll query(int nodo, int l, int r, int lt, int rt) {
        if (l > rt or r < lt) return -1e18;
        if (l >= lt and r <= rt) return st[nodo];
        
        int mid = (l+r) / 2;
        ll L = query(nodo * 2, l, mid, lt, rt);
        ll R = query(nodo * 2 + 1, mid+1, r, lt, rt);

        return max(L,R);
    }

};

struct STmn {

    vector <ll> st;
    STmn (int n){
        st.resize(n * 4);
    }    

    ll oper(ll L, ll R) {
        return min(L, R);
    }

    void build(int nodo, int l, int r, const vector<ll> &v) {
        if (l == r) {
            st[nodo] = v[l];
            return;
        }
        int mid = (l + r) / 2;
        build(nodo * 2, l, mid, v);
        build(nodo * 2 + 1, mid + 1, r, v);
        st[nodo] = oper(st[nodo * 2], st[nodo * 2 + 1]);
    }    

    ll query(int nodo, int l, int r, int lt, int rt) {
        if (l > rt or r < lt) return +1e18;
        if (l >= lt and r <= rt) return st[nodo];
        
        int mid = (l+r) / 2;
        ll L = query(nodo * 2, l, mid, lt, rt);
        ll R = query(nodo * 2 + 1, mid+1, r, lt, rt);

        return oper(L,R);
    }

};


void solve(){

    int n,q;
    cin >> n >> q;

    vector <ll> v(n);
