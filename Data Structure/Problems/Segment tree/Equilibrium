    vector <ll> pares(n);

    read(v);

    forn(i,n){
        ll x;
        cin >> x;
        v[i] -= x;
    }

    ll cont = 0;
    forn(i,n) cont += v[i], current[i] = cont;

    // show(v);
    // dbg();
    // show(current);
    // dbg();

    STsum sum(n);
    STmx mx(n);    
    STmn mn(n);

    sum.build(1,0,n-1,v);
    mx.build(1,0,n-1,current);    
    mn.build(1,0,n-1,current);

    


    while (q--){

        int l,r;
        cin >> l >> r;
        
        l -= 1, r -= 1;

        if (sum.query(1,0,n-1,l,r) != 0){
            cout << "-1" << endl;
            continue;
        }

        ll mnp = (l == 0? 0: current[l-1]);

        if (mx.query(1,0,n-1,l,r) > mnp){
            cout << "-1" << endl;
            continue;
        }
        
        
        ll ans = mn.query(1,0,n-1,l,r) - mnp;
        cout << abs(ans) << endl;
    }

}


